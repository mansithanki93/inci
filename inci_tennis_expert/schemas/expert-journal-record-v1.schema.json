{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inci-tennis-expert:schema:expert-journal-record-v1",
  "title": "Inci Tennis Expert Journal Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "expert_manifest_sha256",
    "provider_request_binding_sha256",
    "match_binding_universe_sha256",
    "retention_binding_sha256",
    "expert_seq",
    "parent",
    "parent_output_index",
    "parent_output_count",
    "event_kind",
    "event_version",
    "event_schema_sha256",
    "prior_expert_record_sha256",
    "prior_expert_state_sha256",
    "payload",
    "post_expert_state_sha256",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "session_id": {"$ref": "#/$defs/uuid"},
    "expert_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "provider_request_binding_sha256": {"$ref": "#/$defs/sha256"},
    "match_binding_universe_sha256": {"$ref": "#/$defs/sha256"},
    "retention_binding_sha256": {"$ref": "#/$defs/sha256"},
    "expert_seq": {"$ref": "#/$defs/positive"},
    "parent": {"$ref": "#/$defs/parent"},
    "parent_output_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "parent_output_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "event_kind": {
      "enum": [
        "synchronization_applied",
        "observation_ignored",
        "observation_rejected"
      ]
    },
    "event_version": {"const": 1},
    "event_schema_sha256": {"$ref": "#/$defs/sha256"},
    "prior_expert_record_sha256": {"$ref": "#/$defs/sha256"},
    "prior_expert_state_sha256": {"$ref": "#/$defs/sha256"},
    "payload": {"$ref": "#/$defs/payload"},
    "post_expert_state_sha256": {"$ref": "#/$defs/sha256"},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {
      "type": "string",
      "pattern": "^(?![Hh][Tt][Tt][Pp][Ss]?:|[Ff][Ii][Ll][Ee]:)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "ingest_seq",
        "record_sha256",
        "event_type",
        "event_version",
        "local_wall_ns",
        "local_monotonic_ns",
        "clock_uncertainty_ns"
      ],
      "properties": {
        "session_id": {"$ref": "#/$defs/uuid"},
        "ingest_seq": {"$ref": "#/$defs/positive"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "event_type": {"$ref": "#/$defs/safeId"},
        "event_version": {"$ref": "#/$defs/positive"},
        "local_wall_ns": {"$ref": "#/$defs/nonnegative"},
        "local_monotonic_ns": {"$ref": "#/$defs/nonnegative"},
        "clock_uncertainty_ns": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "content_type",
        "payload_encoding",
        "payload_contract_name",
        "payload_length",
        "payload_sha256"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "content_type": {"const": "application/vnd.inci.expert+json"},
        "payload_encoding": {"const": "canonical-json-v1"},
        "payload_contract_name": {
          "enum": [
            "ExpertSynchronizationAppliedPayloadV1",
            "ExpertObservationIgnoredPayloadV1",
            "ExpertObservationRejectedPayloadV1"
          ]
        },
        "payload_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 131064
        },
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
