{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inci-tennis-expert:schema:expert-observation-ignored-v1",
  "title": "Inci Tennis Expert Observation Ignored Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation"],
  "properties": {
    "observation": {"$ref": "#/$defs/ignoredObservation"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {
      "type": "string",
      "pattern": "^(?![Hh][Tt][Tt][Pp][Ss]?:|[Ff][Ii][Ll][Ee]:)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999
    },
    "positive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "ingest_seq",
        "record_sha256",
        "event_type",
        "event_version",
        "local_wall_ns",
        "local_monotonic_ns",
        "clock_uncertainty_ns"
      ],
      "properties": {
        "session_id": {"$ref": "#/$defs/uuid"},
        "ingest_seq": {"$ref": "#/$defs/positive"},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "event_type": {"$ref": "#/$defs/safeId"},
        "event_version": {"$ref": "#/$defs/positive"},
        "local_wall_ns": {"$ref": "#/$defs/nonnegative"},
        "local_monotonic_ns": {"$ref": "#/$defs/nonnegative"},
        "clock_uncertainty_ns": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "ignoredObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent",
        "parent_output_index",
        "parent_output_count",
        "normalizer_id",
        "normalizer_code_sha256",
        "normalizer_schema_sha256",
        "reason"
      ],
      "properties": {
        "parent": {"$ref": "#/$defs/parent"},
        "parent_output_index": {"const": 0},
        "parent_output_count": {"const": 1},
        "normalizer_id": {"$ref": "#/$defs/safeId"},
        "normalizer_code_sha256": {"$ref": "#/$defs/sha256"},
        "normalizer_schema_sha256": {"$ref": "#/$defs/sha256"},
        "reason": {
          "enum": [
            "normalizer_not_registered",
            "event_not_relevant"
          ]
        }
      }
    }
  }
}
