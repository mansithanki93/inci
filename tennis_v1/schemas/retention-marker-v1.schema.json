{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inci.example/schemas/retention-marker-v1.schema.json",
  "title": "Tennis v1 provider retention marker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "wal_basename",
    "reserve_basename",
    "delete_by_ns",
    "session_manifest_sha256",
    "provider_request_binding_sha256",
    "provider_manifest_file_sha256",
    "entitlement_id_sha256",
    "qualification_artifact_sha256",
    "created_at_ns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "wal_basename": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.wal$"
    },
    "reserve_basename": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.reserve$"
    },
    "delete_by_ns": {
      "type": "integer",
      "minimum": 1
    },
    "session_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_request_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_manifest_file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entitlement_id_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualification_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at_ns": {
      "type": "integer",
      "minimum": 1
    }
  }
}
