{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inci-tennis-adapters:schema:sportradar-tennis-candidate-authorization-v1",
  "title": "Sportradar tennis candidate authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_created_wall_ns",
    "candidate_manifest_core_sha256",
    "decision",
    "reviewer_id",
    "reviewed_wall_ns",
    "allowed_provider_id",
    "allowed_product_tier",
    "allowed_duration_seconds",
    "allowed_match_ids",
    "required_candidate_capabilities",
    "allowed_strata_sha256",
    "publication_allowed",
    "authorization_evidence_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_id": {"$ref": "#/$defs/safeId"},
    "artifact_created_wall_ns": {"$ref": "#/$defs/nonnegativeInt64"},
    "candidate_manifest_core_sha256": {"$ref": "#/$defs/sha256"},
    "decision": {"const": "approved_for_candidate_read_only_observation"},
    "reviewer_id": {"$ref": "#/$defs/safeId"},
    "reviewed_wall_ns": {"$ref": "#/$defs/nonnegativeInt64"},
    "allowed_provider_id": {"const": "sportradar"},
    "allowed_product_tier": {"$ref": "#/$defs/safeId"},
    "allowed_duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "allowed_match_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safeId"}
    },
    "required_candidate_capabilities": {
      "$ref": "#/$defs/requiredCapabilities"
    },
    "allowed_strata_sha256": {"$ref": "#/$defs/sha256"},
    "publication_allowed": {"const": false},
    "authorization_evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonnegativeInt64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "correction_semantics",
          "current_server",
          "match_format",
          "monotonic_sequence_or_revision",
          "point_state",
          "provider_generated_time",
          "resync_snapshot",
          "source_event_time",
          "stable_match_ids",
          "stable_player_ids"
        ]
      }
    }
  }
}
