{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inci.invalid/schemas/kalshi-orderbook-delta-synthetic-candidate-v1.schema.json",
  "title": "Kalshi synthetic candidate orderbook delta v1",
  "description": "Synthetic Task-8 candidate schema for deterministic offline testing only; it is not captured from or validated against current Kalshi wire data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "ticker", "sequence", "side", "price", "quantity_delta"],
  "properties": {
    "type": {"const": "ORDERBOOK_DELTA"},
    "ticker": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"},
    "sequence": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "side": {"enum": ["YES", "NO"]},
    "price": {"type": "string", "pattern": "^(?:0|1|0\\.[0-9]{0,3}[1-9])$"},
    "quantity_delta": {"type": "string", "pattern": "^-?(?:[1-9][0-9]{0,11}(?:\\.[0-9]{0,3}[1-9])?|0\\.[0-9]{0,3}[1-9])$"}
  }
}
